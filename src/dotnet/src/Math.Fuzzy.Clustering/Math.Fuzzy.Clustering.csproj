    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Math.Fuzzy.Clustering</AssemblyName>
    <RootNamespace>MathFuzzy.Clustering</RootNamespace>
