<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>mfuzzy</AssemblyName>
    <RootNamespace>MathFuzzy.Cli</RootNamespace>
    <Description>Command-line interface for Math.Fuzzy clustering algorithms.</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Math.Fuzzy.Core\Math.Fuzzy.Core.csproj" />
    <ProjectReference Include="..\..\src\Math.Fuzzy.Clustering\Math.Fuzzy.Clustering.csproj" />
    <ProjectReference Include="..\..\src\Math.Fuzzy.Inference\Math.Fuzzy.Inference.csproj" />
  </ItemGroup>

</Project>
