<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>Math.Fuzzy.Desktop</AssemblyName>
    <RootNamespace>MathFuzzy.Desktop</RootNamespace>
    <Description>WPF desktop application for interactive fuzzy clustering analysis.</Description>
    <Product>Fuzzy Tolerance Clustering Workbench</Product>
    <Copyright>Copyright (c) 2026 Aliaksandr Damaratski. MIT License.</Copyright>
    <!-- <ApplicationIcon>Assets\icon.ico</ApplicationIcon> -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.*" />
    <PackageReference Include="OxyPlot.Wpf" Version="2.*" />
    <PackageReference Include="WPF-UI" Version="4.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Math.Fuzzy.Core\Math.Fuzzy.Core.csproj" />
    <ProjectReference Include="..\..\src\Math.Fuzzy.Clustering\Math.Fuzzy.Clustering.csproj" />
    <ProjectReference Include="..\..\src\Math.Fuzzy.Inference\Math.Fuzzy.Inference.csproj" />
  </ItemGroup>

</Project>
