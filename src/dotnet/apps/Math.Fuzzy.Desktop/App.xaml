<Application x:Class="MathFuzzy.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm_data="clr-namespace:MathFuzzy.Desktop.ViewModels.Data"
             xmlns:vm_algo="clr-namespace:MathFuzzy.Desktop.ViewModels.Algorithm"
             xmlns:vm_res="clr-namespace:MathFuzzy.Desktop.ViewModels.Results"
             xmlns:v_data="clr-namespace:MathFuzzy.Desktop.Views.Data"
             xmlns:v_algo="clr-namespace:MathFuzzy.Desktop.Views.Algorithm"
             xmlns:v_res="clr-namespace:MathFuzzy.Desktop.Views.Results"
             Startup="OnStartup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WPF-UI v3: provides NavigationView, Card, InfoBar, ProgressRing styles and Mica backdrop.
                     Must come before old Styles/ so that WPF-UI-specific controls are correctly styled,
                     while old implicit Button/ComboBox/etc. styles defined below still take precedence. -->
                <ui:ThemesDictionary Theme="Light"/>
                <ui:ControlsDictionary/>

                <!-- Design system -->
                <ResourceDictionary Source="Styles/Colors.xaml"/>
                <ResourceDictionary Source="Styles/Palette.xaml"/>
                <ResourceDictionary Source="Styles/Typography.xaml"/>
                <ResourceDictionary Source="Styles/Controls.xaml"/>
                <ResourceDictionary Source="Styles/Components.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Workset card (shared by Dashboard and Data pages) -->
            <DataTemplate x:Key="WorksetCardTemplate">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6"
                            Background="{StaticResource Surface1Brush}"
                            VerticalAlignment="Center" Margin="0,0,10,0">
                        <Grid>
                            <ui:SymbolIcon Symbol="Table24" FontSize="15"
                                           Foreground="{StaticResource Subtext0Brush}"
                                           Visibility="{Binding IsMatrixInput, Converter={StaticResource InverseBoolToVisibility}}"/>
                            <ui:SymbolIcon Symbol="Grid24" FontSize="15"
                                           Foreground="{StaticResource Subtext0Brush}"
                                           Visibility="{Binding IsMatrixInput, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource WorksetName}" Text="{Binding Name}"/>
                        <TextBlock Style="{StaticResource WorksetMeta}"  Text="{Binding Meta}"/>
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource StatusBadge}" VerticalAlignment="Center"
                            Background="{Binding Status, Converter={StaticResource StatusToBrush}}">
                        <TextBlock Style="{StaticResource StatusBadgeText}"
                                   Text="{Binding StatusLabel}"
                                   Foreground="{Binding Status, Converter={StaticResource StatusToForeground}}"/>
                    </Border>
                </Grid>
            </DataTemplate>

            <!-- ViewModel → View bindings -->
            <DataTemplate DataType="{x:Type vm_data:DataPanelViewModel}">
                <v_data:DataPanelView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm_algo:AlgorithmPanelViewModel}">
                <v_algo:AlgorithmPanelView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm_res:MatrixHeatmapTabViewModel}">
                <v_res:MatrixHeatmapView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm_res:ClusterTableTabViewModel}">
                <v_res:ClusterTableView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm_res:MembershipHeatmapTabViewModel}">
                <v_res:MembershipHeatmapView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm_res:DendrogramTabViewModel}">
                <v_res:DendrogramView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm_res:ValidityIndicesTabViewModel}">
                <v_res:ValidityIndicesView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
