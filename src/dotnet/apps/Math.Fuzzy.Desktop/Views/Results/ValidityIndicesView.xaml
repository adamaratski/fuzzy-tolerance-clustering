<UserControl x:Class="MathFuzzy.Desktop.Views.Results.ValidityIndicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="150"/>
            <RowDefinition Height="3"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3"/>
            <RowDefinition Height="*" MinHeight="70"/>
        </Grid.RowDefinitions>

        <!-- F₁(α) curve with α* annotation -->
        <Grid Grid.Row="0">
            <oxy:PlotView Model="{Binding Plot}" Background="{StaticResource BackgroundBrush}"/>
            <TextBlock Text="Run an algorithm to see validity indices."
                       Style="{StaticResource LabelText}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding Plot, Converter={StaticResource NullToInvisibility}}"/>
        </Grid>

        <GridSplitter Grid.Row="1" Height="3" HorizontalAlignment="Stretch"
                      Background="{StaticResource BorderBrush}"/>

        <!-- External validation as metric cards -->
        <Border Grid.Row="2"
                Background="{StaticResource MantleBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="14,10"
                Visibility="{Binding HasExternal, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="EXTERNAL VALIDATION (vs ground truth)"
                           Style="{StaticResource PanelSection}" Margin="0,0,0,8"/>
                <UniformGrid Columns="5">
                    <Border Style="{StaticResource MetricCard}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource MetricBig}" FontSize="22" Text="{Binding Purity}"/>
                            <TextBlock Style="{StaticResource MetricSub}" Text="purity"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCard}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource MetricBig}" FontSize="22" Text="{Binding Ari}"/>
                            <TextBlock Style="{StaticResource MetricSub}" Text="ARI"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCard}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource MetricBig}" FontSize="22" Text="{Binding Nmi}"/>
                            <TextBlock Style="{StaticResource MetricSub}" Text="NMI"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCard}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource MetricBig}" FontSize="22" Text="{Binding Fm}"/>
                            <TextBlock Style="{StaticResource MetricSub}" Text="Fowlkes–Mallows"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource MetricBig}" FontSize="22" Text="{Binding Ri}"/>
                            <TextBlock Style="{StaticResource MetricSub}" Text="Rand index"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Majority class badges -->
                <ItemsControl ItemsSource="{Binding MajorityItems}" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ClusterCentreChip}" Margin="0,0,4,0">
                                <TextBlock Style="{StaticResource ClusterCentreText}" Text="{Binding}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Placeholder when no labels -->
        <Border Grid.Row="2"
                Background="{StaticResource Surface0Brush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="14,10"
                Visibility="{Binding HasExternal, Converter={StaticResource InverseBoolToVisibility}}">
            <TextBlock Style="{StaticResource LabelText}" FontSize="11" TextWrapping="Wrap"
                       Text="Load a labeled dataset (e.g. iris_labeled.csv) to see external validation indices (Purity, ARI, NMI, Fowlkes–Mallows) comparing cluster assignments against ground truth."/>
        </Border>

        <GridSplitter Grid.Row="3" Height="3" HorizontalAlignment="Stretch"
                      Background="{StaticResource BorderBrush}"/>

        <!-- F₁ table -->
        <DataGrid Grid.Row="4" ItemsSource="{Binding Rows}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#"  Binding="{Binding Rank}"  Width="50"/>
                <DataGridTextColumn Header="c"  Binding="{Binding C}"     Width="50"/>
                <DataGridTextColumn Header="α"  Binding="{Binding Alpha}" Width="80"/>
                <DataGridTextColumn Header="F₁" Binding="{Binding F1}"    Width="110"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
