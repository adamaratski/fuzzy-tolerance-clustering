<UserControl x:Class="MathFuzzy.Desktop.Views.Results.MembershipHeatmapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar: solution picker · μ threshold · sort toggle -->
        <Border Grid.Row="0" Background="{StaticResource Surface0Brush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="12,7">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource LabelText}" Text="Solution"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Width="230" Height="24" FontSize="12" Padding="7,2,20,2"
                          ItemsSource="{Binding SolutionItems}"
                          SelectedIndex="{Binding SelectedSolutionIndex}"/>

                <TextBlock Style="{StaticResource LabelText}" Text="threshold μ ≥"
                           VerticalAlignment="Center" Margin="16,0,8,0"/>
                <Slider Width="110" VerticalAlignment="Center"
                        Minimum="0" Maximum="1"
                        TickFrequency="0.01" IsSnapToTickEnabled="True"
                        Value="{Binding Threshold, Delay=150}"/>
                <TextBlock Style="{StaticResource ValueText}" VerticalAlignment="Center" Margin="8,0,0,0"
                           Text="{Binding Threshold, StringFormat={}{0:F2}}"/>

                <CheckBox Content="sort by cluster" Margin="16,0,0,0"
                          VerticalAlignment="Center"
                          IsChecked="{Binding SortByCluster}"/>
            </StackPanel>
        </Border>

        <!-- Heatmap + object detail panel -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="170"/>
            </Grid.ColumnDefinitions>

            <oxy:PlotView x:Name="PlotControl" Grid.Column="0"
                          Model="{Binding Plot}"
                          MouseDown="OnPlotMouseDown"
                          Background="{StaticResource BackgroundBrush}"/>

            <TextBlock Grid.Column="0"
                       Text="Run a clustering algorithm to see membership degrees."
                       Style="{StaticResource LabelText}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding Plot, Converter={StaticResource NullToInvisibility}}"/>

            <Border Grid.Column="1" Background="{StaticResource MantleBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0"
                    Padding="12,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource ValueText}" FontSize="12"
                               Text="{Binding SelectedObjectTitle}" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding ObjectRows}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource LabelText}"
                                               Text="{Binding Label}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource ValueText}"
                                               Text="{Binding Value}">
                                        <TextBlock.Resources>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource ValueText}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMax}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource InfoTextBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Resources>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource LabelText}" FontSize="10" Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Text="Click a heatmap row to inspect that object."/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
