<UserControl x:Class="MathFuzzy.Desktop.Views.Results.ClusterTableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Summary banner -->
        <Border Grid.Row="0" Background="{StaticResource Surface0Brush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="12,8">
            <TextBlock Text="{Binding Summary}" Style="{StaticResource ValueText}" FontSize="13"
                       Foreground="{StaticResource InfoTextBrush}"/>
        </Border>

        <!-- Solutions table (master) -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding SelectedRow}"
                  Margin="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#"       Binding="{Binding Rank}"           Width="40"/>
                <DataGridTextColumn Header="c"       Binding="{Binding C}"              Width="40"/>
                <DataGridTextColumn Header="α"       Binding="{Binding Alpha}"          Width="80"/>
                <DataGridTextColumn Header="F₁"      Binding="{Binding Score}"          Width="80"/>
                <DataGridTextColumn Header="Dist↓"   Binding="{Binding TiebreakerDist}" Width="70">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="ToolTip" Value="Geometric tiebreaker: Σ dist(typical point, centroid). Lower = more compact solution (D-AFC-TC only)."/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Centres" Binding="{Binding Centers}"        Width="160"/>
                <DataGridTextColumn Header="Sizes"   Binding="{Binding ClusterSizes}"   Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Detail: cluster composition pills for the selected solution -->
        <Border Grid.Row="2" Background="{StaticResource MantleBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="12,8"
                Visibility="{Binding SelectedRow, Converter={StaticResource NullToVisibility}}">
            <StackPanel>
                <TextBlock Style="{StaticResource PanelSection}" Margin="0,0,0,6"
                           Text="CLUSTER COMPOSITION"/>
                <WrapPanel>
                    <ItemsControl ItemsSource="{Binding SelectedRow.ClusterPills}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ClusterCentreChip}" Margin="0,0,4,4">
                                    <TextBlock Style="{StaticResource ClusterCentreText}" Text="{Binding}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource ClusterCentreChip}" Margin="0,0,4,4">
                        <TextBlock Style="{StaticResource ClusterCentreText}"
                                   Text="{Binding SelectedRow.IntersectionsText}"
                                   Foreground="{StaticResource InfoTextBrush}"/>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
