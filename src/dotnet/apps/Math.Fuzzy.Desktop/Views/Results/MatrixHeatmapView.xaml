<UserControl x:Class="MathFuzzy.Desktop.Views.Results.MatrixHeatmapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar: T / T̃ toggle · α-slice slider · size & level count -->
        <Border Grid.Row="0" Background="{StaticResource Surface0Brush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="12,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <RadioButton Style="{StaticResource PillToggle}" GroupName="MatrixSource"
                                 Content="T (raw)" Margin="0,0,4,0"
                                 IsChecked="{Binding ShowClosure, Converter={StaticResource InverseBool}}"/>
                    <RadioButton Style="{StaticResource PillToggle}" GroupName="MatrixSource"
                                 Content="T̃ (closure)"
                                 IsChecked="{Binding ShowClosure}"
                                 IsEnabled="{Binding HasClosure}"/>

                    <TextBlock Style="{StaticResource LabelText}" Text="α-slice"
                               VerticalAlignment="Center" Margin="16,0,8,0"/>
                    <Slider Width="130" VerticalAlignment="Center"
                            Minimum="0" Maximum="1"
                            TickFrequency="0.01" IsSnapToTickEnabled="True"
                            Value="{Binding AlphaSlice, Delay=150}"/>
                    <TextBlock Style="{StaticResource ValueText}" VerticalAlignment="Center" Margin="8,0,0,0"
                               Text="{Binding AlphaSlice, StringFormat='α = {0:F2}'}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource ValueText}"
                               Text="{Binding MatrixSize, StringFormat={}{0}×{0}}"/>
                    <TextBlock Style="{StaticResource LabelText}" Text=" · "/>
                    <TextBlock Style="{StaticResource ValueText}"
                               Text="{Binding LevelCount, StringFormat={}{0:N0}}"/>
                    <TextBlock Style="{StaticResource LabelText}" Text=" levels"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Heatmap -->
        <oxy:PlotView Grid.Row="1"
                      Model="{Binding Plot}"
                      Background="{StaticResource BackgroundBrush}"/>

        <TextBlock Grid.Row="1"
                   Text="No tolerance matrix to show: open data, or the data set is too large for a heat map."
                   Style="{StaticResource LabelText}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding Plot, Converter={StaticResource NullToInvisibility}}"/>
    </Grid>
</UserControl>
