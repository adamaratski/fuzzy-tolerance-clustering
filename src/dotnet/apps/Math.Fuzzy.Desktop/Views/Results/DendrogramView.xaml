<UserControl x:Class="MathFuzzy.Desktop.Views.Results.DendrogramView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:MathFuzzy.Desktop.Controls">

    <Grid>
        <!-- Placeholder when no hierarchical result -->
        <TextBlock Text="Run H-AFC-TC to see the dendrogram."
                   Style="{StaticResource LabelText}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding HasResult, Converter={StaticResource InverseBoolToVisibility}}"/>

        <Grid Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Merge tree -->
            <Border Grid.Column="0" Padding="8">
                <ctrl:DendrogramCanvas
                    Result="{Binding Result}"
                    AlphaStar="{Binding AlphaStar}"
                    SelectedAlpha="{Binding SelectedLevel.AlphaValue, FallbackValue=NaN, TargetNullValue=NaN}"/>
            </Border>

            <!-- Level table -->
            <Border Grid.Column="1"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding Levels}"
                              SelectedItem="{Binding SelectedLevel}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="α"     Binding="{Binding Alpha}"        Width="70"/>
                            <DataGridTextColumn Header="c"     Binding="{Binding C}"            Width="40"/>
                            <DataGridTextColumn Header="Sizes" Binding="{Binding ClusterSizes}" Width="*"/>
                            <DataGridTextColumn Header="F₁"    Binding="{Binding Score}"        Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="1" Background="{StaticResource Surface0Brush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                            Padding="10,6">
                        <TextBlock Style="{StaticResource LabelText}" FontSize="10" TextWrapping="Wrap"
                                   Text="Click a level to highlight its cut in the tree. Higher α = finer partition."/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
