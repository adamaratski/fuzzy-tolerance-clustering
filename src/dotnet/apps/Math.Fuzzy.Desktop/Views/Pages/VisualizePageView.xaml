<UserControl x:Class="MathFuzzy.Desktop.Views.Pages.VisualizePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf">

    <!-- DataContext = VisualizePanelViewModel -->
    <Grid Margin="16,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar: workset, feature pickers, coloring; the caption says what the colors mean -->
        <Border Grid.Row="0" Background="{StaticResource Surface0Brush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="12,7" Margin="0,0,0,10">
            <StackPanel>
                <WrapPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource LabelText}" Text="Workset" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <!-- the same active workset as the Dashboard list -->
                    <ComboBox MinWidth="180" Height="24" FontSize="12" Padding="7,2,20,2" Margin="0,0,16,0"
                              AutomationProperties.Name="Workset"
                              ItemsSource="{Binding DataContext.Worksets, RelativeSource={RelativeSource AncestorType=Window}}"
                              SelectedItem="{Binding DataContext.ActiveWorkset, RelativeSource={RelativeSource AncestorType=Window}}">
                        <!-- explicit template: the shared ComboBox template shows SelectionBoxItemTemplate only -->
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Style="{StaticResource LabelText}" Text="X axis" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <ComboBox MinWidth="110" Height="24" FontSize="12" Padding="7,2,20,2" Margin="0,0,16,0"
                              AutomationProperties.Name="X axis"
                              ItemsSource="{Binding Features}"
                              SelectedIndex="{Binding FeatureX}"/>
                    <TextBlock Style="{StaticResource LabelText}" Text="Y axis" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <ComboBox MinWidth="110" Height="24" FontSize="12" Padding="7,2,20,2" Margin="0,0,16,0"
                              AutomationProperties.Name="Y axis"
                              ItemsSource="{Binding Features}"
                              SelectedIndex="{Binding FeatureY}"/>
                    <TextBlock Style="{StaticResource LabelText}" Text="Color by" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <ComboBox MinWidth="110" Height="24" FontSize="12" Padding="7,2,20,2"
                              AutomationProperties.Name="Color by"
                              ItemsSource="{Binding ColorModes}"
                              SelectedItem="{Binding ColorMode}"/>
                </WrapPanel>
                <TextBlock Style="{StaticResource LabelText}" Margin="0,6,0,0" TextWrapping="Wrap"
                           AutomationProperties.Name="Plot caption"
                           Text="{Binding Caption}"
                           Visibility="{Binding Caption, Converter={StaticResource StringToVisibility}}"/>
            </StackPanel>
        </Border>

        <!-- Scatter -->
        <Border Grid.Row="1" Background="{StaticResource Surface0Brush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="6">
            <Grid>
                <oxy:PlotView Model="{Binding Plot}" Background="Transparent"/>
                <TextBlock Style="{StaticResource LabelText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="Open a CSV dataset to visualize objects in feature space."
                           Visibility="{Binding HasData, Converter={StaticResource InverseBoolToVisibility}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
