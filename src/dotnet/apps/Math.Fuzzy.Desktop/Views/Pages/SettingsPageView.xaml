<UserControl x:Class="MathFuzzy.Desktop.Views.Pages.SettingsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DataContext = ShellViewModel -->
    <StackPanel Margin="16,10" MaxWidth="560" HorizontalAlignment="Left">

        <TextBlock Style="{StaticResource PanelSection}" Text="DEFAULTS" Margin="0,0,0,6"/>
        <Border Background="{StaticResource Surface0Brush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource ParamLabel}"
                           Text="Max results (top-N)" VerticalAlignment="Center"/>
                <TextBox  Grid.Row="0" Grid.Column="1"
                          Text="{Binding AlgorithmPanel.MaxResults, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource ParamLabel}"
                           Text="Min cluster size" VerticalAlignment="Center"/>
                <TextBox  Grid.Row="2" Grid.Column="1"
                          Text="{Binding AlgorithmPanel.MinClusterPower, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </Border>

        <TextBlock Style="{StaticResource PanelSection}" Text="ABOUT" Margin="0,14,0,6"/>
        <Border Background="{StaticResource Surface0Brush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="16,12">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" FontSize="15"
                           Text="Fuzzy Tolerance Clustering — Workbench"/>
                <TextBlock Style="{StaticResource LabelText}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="Heuristic possibilistic clustering (Viattchenin): the D-AFC family on a tolerance, its transitive closure, opening and approximations, with partial supervision, for intuitionistic, interval-valued, fuzzy-number, three-way and asymmetric data; hierarchical and dimensionality-reduction variants."/>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource InfoLabel}" Text="UI framework"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource InfoValue}" HorizontalAlignment="Left" Text="WPF-UI 4 · OxyPlot 2 · .NET 10"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource InfoLabel}" Text="Engine"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource InfoValue}" HorizontalAlignment="Left" Text="Math.Fuzzy.Clustering (bitset D-AFC core)"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource InfoLabel}" Text="CLI"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource InfoValue}" HorizontalAlignment="Left" Text="mfuzzy cluster | size | bounds | matrix | reduce | infer | preference | interval-stability | …"/>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
