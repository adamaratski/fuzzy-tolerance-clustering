<UserControl x:Class="MathFuzzy.Desktop.Views.Pages.FuzzySetsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:ctrl="clr-namespace:MathFuzzy.Desktop.Controls"
             xmlns:theory="clr-namespace:MathFuzzy.Desktop.ViewModels.Theory">

    <!-- DataContext = FuzzySetsPageViewModel -->
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Surface0Brush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="12,10"/>
        </Style>
        <Style x:Key="SmallNote" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="Foreground"   Value="{StaticResource Subtext0Brush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="CompactCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Height"    Value="24"/>
            <Setter Property="Padding"   Value="6,2,20,2"/>
            <Setter Property="FontSize"  Value="12"/>
        </Style>

        <!-- one fuzzy set: shape picker, parameter boxes, formula -->
        <DataTemplate DataType="{x:Type theory:FuzzySetEditorViewModel}">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <Rectangle DockPanel.Dock="Left" Width="12" Height="3" Fill="{Binding Accent}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Width="18"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    <ComboBox Style="{StaticResource CompactCombo}"
                              ItemsSource="{x:Static theory:FuzzySetEditorViewModel.ShapeNames}"
                              SelectedIndex="{Binding SelectedShape}"
                              AutomationProperties.Name="{Binding AutomationName}"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Parameters}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,6,4">
                                <TextBlock Style="{StaticResource ParamLabel}" Text="{Binding Name}" Width="14" Margin="0,0,4,0"
                                           VerticalAlignment="Center"/>
                                <TextBox Style="{StaticResource ParamValueEditable}" Width="84" Padding="4,2"
                                         Text="{Binding ValueText}"
                                         AutomationProperties.Name="{Binding AutomationName}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource MonoText}" FontSize="10.5" TextWrapping="Wrap" Margin="0,2,0,0"
                           Foreground="{StaticResource Subtext0Brush}" Text="{Binding Formula}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <TabControl Margin="16,6,16,10" Background="Transparent" BorderThickness="0" Padding="0,8,0,0"
                SelectedIndex="{Binding SelectedTab}">

        <!-- ── SHAPES ─────────────────────────────────────────────────────── -->
        <TabItem Header="Shapes" AutomationProperties.Name="Shapes tab" DataContext="{Binding Shapes}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="290"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,10,0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource PanelSection}" Text="MEMBERSHIP FUNCTION" Margin="0,0,0,8"/>
                                <ContentControl Content="{Binding Set}" Focusable="False"/>
                                <DockPanel Margin="0,12,0,0">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource ParamLabel}" Text="α" Width="14"
                                               Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding AlphaText}" Width="32" TextAlignment="Right"
                                               FontSize="12" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                    <Slider Minimum="0.01" Maximum="1" SmallChange="0.01" LargeChange="0.1" Value="{Binding Alpha}"
                                            VerticalAlignment="Center" AutomationProperties.Name="Alpha level"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource SmallNote}" Margin="0,6,0,0"
                                           Text="Drag the square handles on the plot or type the parameters; the shaded band is the α-cut."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource PanelSection}" Text="CHARACTERISTICS" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding Properties}" Focusable="False"
                                              AutomationProperties.Name="Characteristics">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,6">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource TextBrush}"/>
                                                </DockPanel>
                                                <TextBlock Style="{StaticResource SmallNote}" Text="{Binding Note}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="6">
                    <oxy:PlotView Model="{Binding Plot}" Background="Transparent"
                                  AutomationProperties.Name="Membership function plot"
                                  ctrl:PlotHandleDrag.Target="{Binding}"/>
                </Border>
            </Grid>
        </TabItem>

        <!-- ── OPERATIONS ─────────────────────────────────────────────────── -->
        <TabItem Header="Operations" AutomationProperties.Name="Operations tab" DataContext="{Binding Operations}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="290"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,10,0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource PanelSection}" Text="OPERATION" Margin="0,0,0,8"/>
                                <ComboBox Style="{StaticResource CompactCombo}" AutomationProperties.Name="Operation"
                                          ItemsSource="{Binding Operations}" SelectedIndex="{Binding SelectedOperation}"/>
                                <ComboBox Style="{StaticResource CompactCombo}" Margin="0,6,0,0" AutomationProperties.Name="T-norm"
                                          ItemsSource="{Binding TNorms}" SelectedItem="{Binding SelectedTNorm}"
                                          Visibility="{Binding UsesTNorm, Converter={StaticResource BoolToVisibility}}"/>
                                <ComboBox Style="{StaticResource CompactCombo}" Margin="0,6,0,0" AutomationProperties.Name="S-norm"
                                          ItemsSource="{Binding SNorms}" SelectedItem="{Binding SelectedSNorm}"
                                          Visibility="{Binding UsesSNorm, Converter={StaticResource BoolToVisibility}}"/>
                                <StackPanel Visibility="{Binding UsesImplication, Converter={StaticResource BoolToVisibility}}">
                                    <ComboBox Style="{StaticResource CompactCombo}" Margin="0,6,0,0" AutomationProperties.Name="Implication"
                                              ItemsSource="{Binding Implications}" SelectedItem="{Binding SelectedImplication}"/>
                                    <DockPanel Margin="0,8,0,0">
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource ParamLabel}" Text="firing w" Width="48"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding FiringText}" Width="32" TextAlignment="Right"
                                                   FontSize="12" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                        <Slider Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1" Value="{Binding Firing}"
                                                VerticalAlignment="Center" AutomationProperties.Name="Firing strength"/>
                                    </DockPanel>
                                </StackPanel>
                                <CheckBox Margin="0,8,0,0" Content="Overlay every operator of this family"
                                          IsChecked="{Binding CompareAll}" AutomationProperties.Name="Overlay every operator"
                                          Visibility="{Binding CanCompare, Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock Style="{StaticResource MonoText}" FontSize="10.5" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Foreground="{StaticResource Subtext0Brush}" Text="{Binding Formula}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource PanelSection}" Text="SETS" Margin="0,0,0,8"/>
                                <ContentControl Content="{Binding SetA}" Focusable="False"/>
                                <ContentControl Content="{Binding SetB}" Focusable="False" Margin="0,12,0,0"
                                                Visibility="{Binding UsesSetB, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="6">
                        <oxy:PlotView Model="{Binding Plot}" Background="Transparent"
                                      AutomationProperties.Name="Operation plot"
                                      ctrl:PlotHandleDrag.Target="{Binding}"/>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PanelSection}" Text="DEFUZZIFICATION OF THE RESULT" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding Defuzzifications}" Focusable="False"
                                          AutomationProperties.Name="Defuzzification results">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,18,2">
                                            <Rectangle Width="3" Height="14" Fill="{Binding Accent}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Method}" FontSize="12" Foreground="{StaticResource Subtext0Brush}"
                                                       Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Value}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </TabItem>

        <!-- ── FROM CLUSTER ───────────────────────────────────────────────── -->
        <TabItem Header="From cluster" AutomationProperties.Name="From cluster tab" DataContext="{Binding FromCluster}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,10">
                    <WrapPanel>
                        <TextBlock Style="{StaticResource ParamLabel}" Text="Solution" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <ComboBox Style="{StaticResource CompactCombo}" Width="176" AutomationProperties.Name="Clustering solution"
                                  ItemsSource="{Binding Solutions}" SelectedIndex="{Binding SelectedSolution}"/>
                        <TextBlock Style="{StaticResource ParamLabel}" Text="Cluster" Margin="12,0,6,0" VerticalAlignment="Center"/>
                        <ComboBox Style="{StaticResource CompactCombo}" Width="70" AutomationProperties.Name="Cluster"
                                  ItemsSource="{Binding Clusters}" SelectedIndex="{Binding SelectedCluster}"/>
                        <TextBlock Style="{StaticResource ParamLabel}" Text="Attribute" Margin="12,0,6,0" VerticalAlignment="Center"/>
                        <ComboBox Style="{StaticResource CompactCombo}" Width="130" AutomationProperties.Name="Attribute"
                                  ItemsSource="{Binding Features}" SelectedIndex="{Binding SelectedFeature}"/>
                        <TextBlock Style="{StaticResource ParamLabel}" Text="Term shape" Margin="12,0,6,0" VerticalAlignment="Center"/>
                        <ComboBox Style="{StaticResource CompactCombo}" Width="176" AutomationProperties.Name="Term shape"
                                  ItemsSource="{Binding ShapeNames}" SelectedIndex="{Binding SelectedShape}"/>
                    </WrapPanel>
                </Border>

                <Border Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Left" MaxWidth="640"
                        Background="{StaticResource InfoFillBrush}" BorderBrush="{StaticResource InfoEdgeBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="12,9"
                        Visibility="{Binding HasData, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Info24" FontSize="16" Margin="0,0,8,0"
                                       Foreground="{StaticResource InfoTextBrush}" VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource LabelText}" TextWrapping="Wrap" MaxWidth="580"
                                   Foreground="{StaticResource InfoTextBrush}" Text="{Binding EmptyMessage}"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="350"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="6">
                        <oxy:PlotView Model="{Binding Plot}" Background="Transparent"
                                      AutomationProperties.Name="Antecedent construction plot"/>
                    </Border>
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource PanelSection}" Text="CONSTRUCTION (MONOGRAPH SEC. 4.5.2)" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False"
                                              AutomationProperties.Name="Construction values">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="62"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Symbol}" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" TextWrapping="Wrap"
                                                           Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Equation}" FontSize="11"
                                                           Foreground="{StaticResource InfoTextBrush}"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource SmallNote}"
                                                           Text="{Binding Meaning}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource SmallNote}" Margin="0,6,0,0" Text="{Binding Note}"/>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
