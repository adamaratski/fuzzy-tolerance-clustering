<UserControl x:Class="MathFuzzy.Desktop.Views.Pages.DataPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="16,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: worksets + actions -->
        <StackPanel Grid.Column="0">
            <TextBlock Style="{StaticResource PanelSection}" Text="WORKSETS" Margin="0,0,0,6"/>
            <ListBox Style="{StaticResource WorksetListBox}"
                     MaxHeight="320"
                     ItemTemplate="{StaticResource WorksetCardTemplate}"
                     ItemsSource="{Binding Worksets}"
                     SelectedItem="{Binding ActiveWorkset}"/>

            <TextBlock Style="{StaticResource PanelSection}" Text="ACTIONS" Margin="0,12,0,6"/>
            <WrapPanel>
                <Button Margin="0,0,6,6" Command="{Binding OpenCsvCommand}"
                        ToolTip="Load raw data from CSV (objects × features)">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Open CSV" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Content="Open Matrix" Margin="0,0,6,6" Command="{Binding OpenMatrixCommand}"
                        ToolTip="Load a pre-built n×n tolerance matrix"/>
                <Button Content="Build T" Margin="0,0,6,6" Command="{Binding BuildMatrixCommand}"
                        ToolTip="Build fuzzy tolerance matrix T from raw data"/>
                <Button Content="Closure T̃" Margin="0,0,6,6" Command="{Binding ClosureCommand}"
                        ToolTip="Compute max-min transitive closure T̃"/>
            </WrapPanel>
        </StackPanel>

        <!-- Right: dataset details + preview -->
        <StackPanel Grid.Column="2">
            <TextBlock Style="{StaticResource PanelSection}" Text="ACTIVE DATASET" Margin="0,0,0,6"/>
            <Border Background="{StaticResource Surface0Brush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="12,8">
                <ContentControl Content="{Binding DataPanel}"/>
            </Border>

            <TextBlock Style="{StaticResource PanelSection}" Text="DATA PREVIEW" Margin="0,12,0,6"/>
            <Border Background="{StaticResource Surface0Brush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="12,8">
                <ScrollViewer MaxHeight="320"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <TextBlock Style="{StaticResource MonoText}" FontSize="11"
                               Text="{Binding DataPreview}"/>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
