<ui:FluentWindow
    x:Class="MathFuzzy.Desktop.Views.Workspace.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:MathFuzzy.Desktop.ViewModels.Workspace"
    xmlns:pages="clr-namespace:MathFuzzy.Desktop.Views.Pages"
    xmlns:ctrl="clr-namespace:MathFuzzy.Desktop.Controls"
    Title="Fuzzy Tolerance Clustering — Workbench"
    Width="1440" Height="860"
    MinWidth="1000" MinHeight="640"
    WindowStartupLocation="CenterScreen"
    WindowBackdropType="None"
    Background="{StaticResource BackgroundBrush}"
    ExtendsContentIntoTitleBar="True">

    <ui:FluentWindow.Resources>

        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="GroupName"                  Value="Nav"/>
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="Foreground"                 Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="HorizontalAlignment"        Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize"                   Value="13"/>
            <Setter Property="FontFamily"                 Value="Segoe UI"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="FocusVisualStyle"           Value="{x:Null}"/>
            <Setter Property="Command"                    Value="{Binding NavigateCommand}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="3,0,0,0"
                                CornerRadius="0,4,4,0"
                                Margin="0,1,8,1"
                                Padding="12,7">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="{StaticResource InfoFillBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource InfoTextBrush}"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="{StaticResource Surface1Brush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavHeader" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Subtext0Brush}"/>
            <Setter Property="Margin"     Value="16,12,16,3"/>
        </Style>

    </ui:FluentWindow.Resources>

    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="O" Modifiers="Control"       Command="{Binding OpenCsvCommand}"/>
        <KeyBinding Key="O" Modifiers="Control+Shift" Command="{Binding OpenMatrixCommand}"/>
        <KeyBinding Key="E" Modifiers="Control"       Command="{Binding ExportCommand}" CommandParameter="json"/>
    </ui:FluentWindow.InputBindings>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*" MinWidth="420"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- TITLE BAR -->
        <Grid Grid.Row="0" Grid.ColumnSpan="3" Background="{StaticResource MantleBrush}">
            <!-- short title; the window title keeps the full name for the taskbar -->
            <ui:TitleBar Title="Fuzzy Tolerance Clustering"/>
        </Grid>

        <!-- LEFT NAV -->
        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource MantleBrush}">
            <DockPanel>
                <RadioButton DockPanel.Dock="Bottom" Style="{StaticResource NavItem}" Margin="0,0,0,8"
                             CommandParameter="settings">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Settings24" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Settings" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,8,0,8">
                        <TextBlock Style="{StaticResource NavHeader}" Text="GENERAL"/>
                        <RadioButton Style="{StaticResource NavItem}" IsChecked="True"
                                     CommandParameter="dashboard">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Home24" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}"
                                     CommandParameter="data">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Database24" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Data &amp; worksets" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}"
                                     CommandParameter="visualize">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DataBarVertical24" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Visualize" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <TextBlock Style="{StaticResource NavHeader}" Text="ALGORITHMS"/>
                        <RadioButton Style="{StaticResource NavItem}"
                                     CommandParameter="cat-relational">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Link24" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Relational" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}"
                                     CommandParameter="cat-prototype">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ShapeSubtract24" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Prototype-based" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}"
                                     CommandParameter="cat-hierarchical">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="TextSortDescending24" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Hierarchical" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}"
                                     CommandParameter="cat-dr">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowMinimize24" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Dim. reduction" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}"
                                     CommandParameter="cat-ifs">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="CircleHalfFill24" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Intuitionistic" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <TextBlock Style="{StaticResource NavHeader}" Text="THEORY"/>
                        <RadioButton Style="{StaticResource NavItem}"
                                     CommandParameter="mf">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="MathFormula24" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Fuzzy sets" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}"
                                     CommandParameter="fis">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Flash24" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Inference (FIS)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- CENTER PANEL -->
        <Grid Grid.Row="1" Grid.Column="1" Background="{StaticResource BackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Page header -->
            <Border Grid.Row="0" Padding="16,10,16,6"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Style="{StaticResource PageTitle}" Text="{Binding PageTitle}" VerticalAlignment="Center"/>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal"
                                Visibility="{Binding IsDashboard, Converter={StaticResource BoolToVisibility}}">
                        <!-- While a run is in progress: algorithm, elapsed time and Stop instead of Run -->
                        <TextBlock Text="{Binding RunningText}" VerticalAlignment="Center" Margin="0,0,10,0"
                                   FontSize="12" Foreground="{StaticResource Subtext0Brush}"
                                   AutomationProperties.Name="Run elapsed time"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                        <!-- Command bar: data in, results out, then the run itself -->
                        <Button x:Name="OpenDataButton" Style="{StaticResource HeaderCommandButton}"
                                Click="OnDropDownClick"
                                AutomationProperties.Name="Open data"
                                ToolTip="Open a dataset (CSV, Ctrl+O) or a tolerance matrix (Ctrl+Shift+O)">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Open data" VerticalAlignment="Center"/>
                                <TextBlock Text="▾" FontSize="10" Margin="6,1,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource Subtext0Brush}"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="CSV data…" InputGestureText="Ctrl+O"
                                              Command="{Binding OpenCsvCommand}"
                                              AutomationProperties.Name="Open CSV data"/>
                                    <MenuItem Header="Tolerance matrix…" InputGestureText="Ctrl+Shift+O"
                                              Command="{Binding OpenMatrixCommand}"
                                              AutomationProperties.Name="Open tolerance matrix"/>
                                    <Separator/>
                                    <MenuItem Header="Intuitionistic tolerance (μ and ν matrices)…"
                                              Command="{Binding OpenIntuitionisticRelationCommand}"
                                              AutomationProperties.Name="Open intuitionistic tolerance"/>
                                    <MenuItem Header="Intuitionistic attribute data…"
                                              Command="{Binding OpenIntuitionisticDataCommand}"
                                              AutomationProperties.Name="Open intuitionistic data"/>
                                    <Separator/>
                                    <MenuItem Header="Interval-valued data…"
                                              Command="{Binding OpenIntervalDataCommand}"
                                              AutomationProperties.Name="Open interval-valued data"/>
                                    <MenuItem Header="Fuzzy-number data…"
                                              Command="{Binding OpenFuzzyNumberDataCommand}"
                                              AutomationProperties.Name="Open fuzzy-number data"/>
                                    <MenuItem Header="Three-way data…"
                                              Command="{Binding OpenThreeWayDataCommand}"
                                              AutomationProperties.Name="Open three-way data"/>
                                    <MenuItem Header="Asymmetric proximity matrix…"
                                              Command="{Binding OpenAsymmetricMatrixCommand}"
                                              AutomationProperties.Name="Open asymmetric matrix"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Style="{StaticResource HeaderCommandButton}" Margin="6,0,0,0"
                                Click="OnDropDownClick"
                                IsEnabled="{Binding CanExportResults}"
                                AutomationProperties.Name="Export results"
                                ToolTip="{Binding ExportToolTip}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowExportLtr24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Export" VerticalAlignment="Center"/>
                                <TextBlock Text="▾" FontSize="10" Margin="6,1,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource Subtext0Brush}"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Results as JSON…" InputGestureText="Ctrl+E"
                                              Command="{Binding ExportCommand}" CommandParameter="json"
                                              AutomationProperties.Name="Export results as JSON"/>
                                    <MenuItem Header="Results as CSV…"
                                              Command="{Binding ExportCommand}" CommandParameter="csv"
                                              AutomationProperties.Name="Export results as CSV"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Rectangle Width="1" Height="22" Margin="12,0" VerticalAlignment="Center"
                                   Fill="{StaticResource BorderBrush2}"/>
                        <Button Style="{StaticResource RunSelectedButton}"
                                Command="{Binding StopCommand}"
                                AutomationProperties.Name="Stop"
                                ToolTip="Stop the running algorithm"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Stop24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Stop" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RunSelectedButton}"
                                Command="{Binding RunCommand}"
                                AutomationProperties.Name="Run selected"
                                Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Play24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Run selected" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Run progress across the top of the page, visible from any scroll position -->
            <ProgressBar Grid.Row="1" VerticalAlignment="Top" Panel.ZIndex="1" Height="3" MinHeight="0"
                         Value="{Binding ProgressValue}" Maximum="100"
                         IsIndeterminate="{Binding ProgressIndeterminate}"
                         AutomationProperties.Name="Run progress"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>

            <!-- Pages -->
            <Grid Grid.Row="1">

                <!-- ── DASHBOARD ─────────────────────────────────────── -->
                <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=dashboard}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Worksets -->
                    <Border Grid.Row="0" Padding="16,10,16,4">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PanelSection}" Text="WORKSETS"/>
                            <ListBox Style="{StaticResource WorksetListBox}"
                                     ItemTemplate="{StaticResource WorksetCardTemplate}"
                                     ItemsSource="{Binding Worksets}"
                                     SelectedItem="{Binding ActiveWorkset}"/>
                        </StackPanel>
                    </Border>

                    <!-- Results TabControl -->
                    <TabControl Grid.Row="1" Margin="16,0,16,4"
                                ItemsSource="{Binding ResultTabs}"
                                SelectedItem="{Binding SelectedTab, Mode=TwoWay}">
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}"/>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate>
                                <ContentPresenter Content="{Binding}"/>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>

                    <!-- Best result row (success infobar per mockup) -->
                    <Border Grid.Row="2" Margin="16,6" Padding="10,7"
                            Background="{StaticResource SuccessFillBrush}"
                            BorderBrush="{StaticResource SuccessEdgeBrush}" BorderThickness="1"
                            CornerRadius="6"
                            Visibility="{Binding HasBestResult, Converter={StaticResource BoolToVisibility}}">
                        <!-- one text block: the runs share a baseline whatever fallback fonts the symbols need -->
                        <TextBlock FontFamily="Segoe UI" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{StaticResource Subtext0Brush}">
                            <Run Text="Best:"/>
                            <Run Text="{Binding BestResultSummary, Mode=OneWay}" FontWeight="SemiBold"
                                 Foreground="{StaticResource SuccessBrush}"/>
                            <Run Text="&#160;&#160;&#160;c ="/>
                            <Run Text="{Binding BestC, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            <Run Text="&#160;&#160;&#160;Purity ="/>
                            <Run Text="{Binding BestPurity, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            <Run Text="&#160;&#160;&#160;ARI ="/>
                            <Run Text="{Binding BestAri, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        </TextBlock>
                    </Border>

                    <!-- Metric tiles -->
                    <WrapPanel Grid.Row="3" Margin="16,4,16,4"
                               Visibility="{Binding HasBestResult, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource MetricCard}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource MetricBig}"  Text="{Binding BestC}"/>
                                <TextBlock Style="{StaticResource MetricSub}"  Text="clusters"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCard}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource MetricBig}"  Text="{Binding BestPurity}"/>
                                <TextBlock Style="{StaticResource MetricSub}"  Text="purity"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource MetricBig}"  Text="{Binding BestAri}"/>
                                <TextBlock Style="{StaticResource MetricSub}"  Text="ARI"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <!-- Cluster centres -->
                    <ItemsControl Grid.Row="4" Margin="16,0,16,8"
                                  ItemsSource="{Binding BestCentres}"
                                  Visibility="{Binding HasBestResult, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ClusterCentreChip}" Margin="0,0,4,4">
                                    <TextBlock Style="{StaticResource ClusterCentreText}" Text="{Binding}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- ── DATA & WORKSETS ───────────────────────────────── -->
                <pages:DataPageView
                    Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=data}"/>

                <!-- ── VISUALIZE ─────────────────────────────────────── -->
                <pages:VisualizePageView
                    DataContext="{Binding VisualizePanel}"
                    Visibility="{Binding DataContext.CurrentPage,
                                 RelativeSource={RelativeSource AncestorType=Window},
                                 Converter={StaticResource PageVisibility}, ConverterParameter=visualize}"/>

                <!-- ── FUZZY SETS ────────────────────────────────────── -->
                <pages:FuzzySetsPageView
                    DataContext="{Binding FuzzySets}"
                    Visibility="{Binding DataContext.CurrentPage,
                                 RelativeSource={RelativeSource AncestorType=Window},
                                 Converter={StaticResource PageVisibility}, ConverterParameter=mf}"/>

                <!-- ── INFERENCE (FIS) ───────────────────────────────── -->
                <pages:InferencePageView
                    DataContext="{Binding Inference}"
                    Visibility="{Binding DataContext.CurrentPage,
                                 RelativeSource={RelativeSource AncestorType=Window},
                                 Converter={StaticResource PageVisibility}, ConverterParameter=fis}"/>

                <!-- ── SETTINGS ──────────────────────────────────────── -->
                <pages:SettingsPageView
                    Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=settings}"/>
            </Grid>
        </Grid>

        <!-- RIGHT SIDEBAR (dashboard only) -->
        <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource MantleBrush}" Width="296"
                Visibility="{Binding IsDashboard, Converter={StaticResource BoolToVisibility}}">
          <DockPanel LastChildFill="True">

            <!-- SYSTEM RESOURCES (Task-Manager style), pinned to the bottom of the panel -->
            <Border DockPanel.Dock="Bottom"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                    Padding="12,2,12,8">
                <StackPanel>
                    <DockPanel Margin="0,8,0,6">
                        <ToggleButton DockPanel.Dock="Right"
                                      Style="{x:Null}" OverridesDefaultStyle="True"
                                      IsChecked="{Binding ResourceMonitor.IsExpanded}"
                                      Cursor="Hand" ToolTip="Show or hide the load of the processor, the memory and the graphics adapters"
                                      AutomationProperties.Name="Show system monitor">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <TextBlock x:Name="Txt" Text="show" FontSize="10"
                                               Foreground="{StaticResource AccentBrush}"
                                               Background="Transparent"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Txt" Property="Text" Value="hide"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ToggleButton DockPanel.Dock="Right" Margin="0,0,10,0"
                                      Style="{x:Null}" OverridesDefaultStyle="True"
                                      IsChecked="{Binding ResourceMonitor.IsPaused}"
                                      Cursor="Hand" ToolTip="Pause or resume sampling"
                                      AutomationProperties.Name="Pause resource monitor"
                                      Visibility="{Binding ResourceMonitor.IsExpanded, Converter={StaticResource BoolToVisibility}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <TextBlock x:Name="Txt" Text="pause" FontSize="10"
                                               Foreground="{StaticResource AccentBrush}"
                                               Background="Transparent"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Txt" Property="Text" Value="resume"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <TextBlock Style="{StaticResource PanelSection}" Text="SYSTEM" Margin="0"/>
                        <TextBlock Margin="10,0,0,0" FontSize="10.5" VerticalAlignment="Center"
                                   Foreground="{StaticResource Subtext0Brush}"
                                   Text="{Binding ResourceMonitor.Summary}"
                                   AutomationProperties.Name="System load"
                                   Visibility="{Binding ResourceMonitor.IsExpanded, Converter={StaticResource InverseBoolToVisibility}}"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding ResourceMonitor.Meters}" Focusable="False"
                                  Visibility="{Binding ResourceMonitor.IsExpanded, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6"
                                      AutomationProperties.Name="{Binding AutomationName}"
                                      ToolTip="{Binding Subtitle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                    <Setter Property="Opacity" Value="0.55"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Border Grid.Column="0" Height="34"
                                            BorderBrush="{Binding Accent}" BorderThickness="1"
                                            Background="{StaticResource Surface0Brush}"
                                            VerticalAlignment="Center">
                                        <ctrl:Sparkline Values="{Binding History}" Stroke="{Binding Accent}" Capacity="60"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ValueText}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="10.5"
                                                   Foreground="{StaticResource Subtext0Brush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Subtitle, Converter={StaticResource StringToVisibility}}"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="10.5"
                                                   Foreground="{StaticResource Subtext0Brush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Detail, Converter={StaticResource StringToVisibility}}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="12,8,24,8">
                    <TextBlock Style="{StaticResource PanelSection}" Text="ALGORITHM"/>
                    <ContentControl Content="{Binding AlgorithmPanel}"/>

                    <TextBlock Style="{StaticResource PanelSection}" Text="PROGRESS" Margin="0,12,0,4"/>
                    <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource ProgressPhaseText}" Text="{Binding ProgressPhaseText}"/>
                        <ProgressBar Style="{StaticResource ThinProgressBar}"
                                     Value="{Binding ProgressValue}" Maximum="100"
                                     IsIndeterminate="{Binding ProgressIndeterminate}"
                                     Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock Foreground="{StaticResource Subtext0Brush}" FontSize="12"
                               Text="No run in progress."
                               Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisibility}}"/>

                    <TextBlock Style="{StaticResource PanelSection}" Text="DATASET" Margin="0,12,0,4"/>
                    <ContentControl Content="{Binding DataPanel}"/>
                </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                Style="{StaticResource StatusBarBorder}">
            <TextBlock Style="{StaticResource StatusText}"
                       Text="{Binding StatusMessage}" Margin="12,0"/>
        </Border>

    </Grid>
</ui:FluentWindow>
