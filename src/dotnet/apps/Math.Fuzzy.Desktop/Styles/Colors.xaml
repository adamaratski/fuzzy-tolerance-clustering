<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Light palette matching the approved UI mockup (claude.ai design tokens):
        white surfaces, warm light-gray page background, blue info accent #378ADD,
        coral #D85A30 for α* markers. Gray ramp from the design system.
    -->

    <!-- Gray ramp (design system) -->
    <Color x:Key="ColorGray50">#F1EFE8</Color>
    <Color x:Key="ColorGray100">#D3D1C7</Color>
    <Color x:Key="ColorGray200">#B4B2A9</Color>
    <Color x:Key="ColorGray400">#888780</Color>
    <Color x:Key="ColorGray600">#5F5E5A</Color>
    <Color x:Key="ColorGray800">#444441</Color>
    <Color x:Key="ColorGray900">#2C2C2A</Color>

    <!-- Design blue ramp + coral accent for α* markers -->
    <Color x:Key="ColorBlue50">#E6F1FB</Color>
    <Color x:Key="ColorBlue100">#B5D4F4</Color>
    <Color x:Key="ColorBlue200">#85B7EB</Color>
    <Color x:Key="ColorBlue400">#378ADD</Color>
    <Color x:Key="ColorBlue600">#185FA5</Color>
    <Color x:Key="ColorBlue800">#0C447C</Color>
    <Color x:Key="ColorBlue900">#042C53</Color>
    <Color x:Key="ColorCoral">#D85A30</Color>

    <!-- Semantic (light theme) -->
    <Color x:Key="ColorPageBackground">#F4F2EC</Color>
    <Color x:Key="ColorPanel">#FFFFFF</Color>
    <Color x:Key="ColorHover">#F1EFE8</Color>
    <Color x:Key="ColorPressed">#E3E1D9</Color>
    <Color x:Key="ColorBorder">#DDDBD2</Color>
    <Color x:Key="ColorBorderStrong">#C9C7BE</Color>
    <Color x:Key="ColorTextPrimary">#2C2C2A</Color>
    <Color x:Key="ColorTextSecondary">#5F5E5A</Color>
    <Color x:Key="ColorTextTertiary">#888780</Color>
    <Color x:Key="ColorSuccessText">#3B6D11</Color>
    <Color x:Key="ColorWarnText">#854F0B</Color>
    <Color x:Key="ColorErrorText">#A32D2D</Color>

    <!-- Semantic brushes (names kept from the dark theme for compatibility):
         Background = page, Mantle = panels (nav/titlebar/sidebar), Surface0 = cards/controls,
         Surface1 = hover/badges, Surface2 = pressed/selected, Crust = text on accent. -->
    <SolidColorBrush x:Key="BackgroundBrush"    Color="{StaticResource ColorPageBackground}"/>
    <SolidColorBrush x:Key="MantleBrush"        Color="{StaticResource ColorPanel}"/>
    <SolidColorBrush x:Key="CrustBrush"         Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Surface0Brush"      Color="{StaticResource ColorPanel}"/>
    <SolidColorBrush x:Key="Surface1Brush"      Color="{StaticResource ColorHover}"/>
    <SolidColorBrush x:Key="Surface2Brush"      Color="{StaticResource ColorPressed}"/>
    <SolidColorBrush x:Key="OverlayBrush"       Color="{StaticResource ColorTextTertiary}"/>
    <SolidColorBrush x:Key="Subtext0Brush"      Color="{StaticResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="TextBrush"          Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="AccentBrush"        Color="{StaticResource ColorBlue400}"/>
    <SolidColorBrush x:Key="SuccessBrush"       Color="{StaticResource ColorSuccessText}"/>
    <SolidColorBrush x:Key="BorderBrush"        Color="{StaticResource ColorBorder}"/>
    <SolidColorBrush x:Key="BorderBrush2"       Color="{StaticResource ColorBorderStrong}"/>

    <SolidColorBrush x:Key="Blue400Brush"       Color="{StaticResource ColorBlue400}"/>
    <SolidColorBrush x:Key="CoralBrush"         Color="{StaticResource ColorCoral}"/>

    <!-- Semantic fills for badges/infobars (light tints + dark text from the same ramp) -->
    <SolidColorBrush x:Key="SuccessFillBrush"   Color="#EAF3DE"/>
    <SolidColorBrush x:Key="SuccessEdgeBrush"   Color="#C0DD97"/>
    <SolidColorBrush x:Key="InfoFillBrush"      Color="{StaticResource ColorBlue50}"/>
    <SolidColorBrush x:Key="InfoEdgeBrush"      Color="{StaticResource ColorBlue100}"/>
    <SolidColorBrush x:Key="InfoTextBrush"      Color="{StaticResource ColorBlue600}"/>

</ResourceDictionary>
