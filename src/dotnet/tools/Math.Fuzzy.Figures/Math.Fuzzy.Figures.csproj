<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>mfuzzy-figures</AssemblyName>
    <RootNamespace>MathFuzzy.Figures</RootNamespace>
    <Description>Draws the figures of the book from the data sets and the measurements of the repository.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OxyPlot.Wpf" Version="2.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Math.Fuzzy.Core\Math.Fuzzy.Core.csproj" />
    <ProjectReference Include="..\..\src\Math.Fuzzy.Clustering\Math.Fuzzy.Clustering.csproj" />
    <ProjectReference Include="..\..\src\Math.Fuzzy.Inference\Math.Fuzzy.Inference.csproj" />
  </ItemGroup>

</Project>
